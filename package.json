{
  "name": "work-instructions",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --test scripts/tests/*.test.mjs && playwright test tests/manufacturing.spec.ts tests/backend-gateway.spec.ts tests/media.spec.ts tests/editor-content.spec.ts tests/dashboard-layout.spec.ts tests/secret-box.spec.ts",
    "test:e2e": "playwright test --config=playwright.ui.config.ts",
    "test:sql": "node scripts/test-database.mjs",
    "docker:build": "docker build -t work-instructions:latest .",
    "docker:run": "docker compose up --build",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:status": "npx supabase status",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "test:integration:demo-data": "node scripts/tests/integration-demo-data.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "clsx": "^2.1.1",
    "dom-serializer": "^3.1.1",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.12.0",
    "marked": "^18.1.3",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "posthog-js": "^1.352.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanitize-html": "^2.17.1",
    "tailwind-merge": "^3.5.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "tus-js-client": "^4.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
